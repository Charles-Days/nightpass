# App
NODE_ENV=development
PORT=7101

# Database
DATABASE_URL="postgresql://charlesdays@localhost:5432/nightpass_dev?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long"
JWT_REFRESH_TTL="30d"

# CORS — comma-separated origins. Empty = allow all (dev only).
CORS_ORIGINS=

# Resend (https://resend.com — free tier 3k/mes)
# En dev: deja RESEND_API_KEY vacío y los emails se loguean en consola en lugar de enviarse.
# Para enviar de verdad: alta una API key y usa "onboarding@resend.dev" como MAIL_FROM
# hasta verificar tu dominio.
RESEND_API_KEY=
MAIL_FROM="onboarding@resend.dev"
ADMIN_NOTIFICATION_EMAIL="admin@nightpass.local"

# URL pública del panel admin (para construir links en emails).
ADMIN_WEB_URL="http://localhost:7100"

# Cloudflare R2 (opcional — para upload de imágenes)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nightpass-media
R2_PUBLIC_URL=https://pub-XXXXX.r2.dev
