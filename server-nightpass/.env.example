# App
NODE_ENV=development
PORT=7101

# Database
DATABASE_URL="postgresql://charlesdays@localhost:5432/nightpass_dev?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT (min 32 chars cada uno)
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long"
JWT_REFRESH_TTL="30d"

# CORS — comma-separated origins. Vacío en producción lanza al boot.
# Dev: vacío → CORS efectivamente bloqueado (mejor explícito).
CORS_ORIGINS=http://localhost:7100

# Mailer SMTP — sin SMTP_USER/SMTP_PASS el mailer corre en modo no-op (loguea en consola).
# Producción NightPass usa Gmail SMTP con contraseña de aplicación.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NightPass <no-reply@nightpass.mx>"
ADMIN_NOTIFICATION_EMAIL="admin@nightpass.local"

# URL pública del panel admin (para construir links en emails).
ADMIN_WEB_URL="http://localhost:7100"

# Storage — driver `r2` en prod, `local` en dev.
STORAGE_DRIVER=local
LOCAL_UPLOADS_PATH=./uploads
LOCAL_UPLOADS_URL=http://localhost:7101/uploads

# Cloudflare R2 (requerido si STORAGE_DRIVER=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nightpass-media
R2_PUBLIC_URL=https://pub-XXXXX.r2.dev

# Stripe Connect (Fase 3) — sin estas vars el módulo stripe corre en modo no-op.
# Si STRIPE_SECRET_KEY está set, STRIPE_WEBHOOK_SECRET es obligatorio.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLATFORM_FEE_PCT=8
STRIPE_CONNECT_COUNTRY=MX
STRIPE_CONNECT_DEFAULT_CURRENCY=mxn

# Bypass de compra directa SOLO para desarrollo (emite pases sin cobrar).
# El boot FALLA si queda 'true' con NODE_ENV=production. Dejar vacío en prod.
STRIPE_DEV_BYPASS=

# Pass HMAC signing — secreto para firmar QR codes de pases. Min 32 chars.
# OBLIGATORIO en producción (el boot falla sin él): firma TODOS los QR, también
# los del flujo en efectivo/RP que no usa Stripe. Sin él no hay firma segura.
PASS_HMAC_SECRET=

# WhatsApp Cloud API (Meta). Sin TOKEN/PHONE_NUMBER_ID corre en modo no-op.
# TOKEN = token permanente del System User. PHONE_NUMBER_ID y WABA_ID salen de
# WhatsApp → API Setup en developers.facebook.com.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
SMS_DEFAULT_COUNTRY_CODE=52

# Confianza en proxies para derivar la IP real (X-Forwarded-For). El rate-limit
# y el ban son por IP. En PRODUCCIÓN es obligatorio y NO puede ser 'true' (el
# boot falla): usar el número exacto de saltos (p.ej. 2 = Cloudflare→Coolify) o
# una lista de IPs/CIDR del proxy. En dev se puede omitir (default seguro = 1).
TRUST_PROXY=

# Web Push (VAPID) — generar con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:tu-email@ejemplo.com"
