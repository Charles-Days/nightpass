# App
NODE_ENV=development
PORT=7101

# Database
DATABASE_URL="postgresql://charlesdays@localhost:5432/nightpass_dev?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT (min 32 chars cada uno)
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long"
JWT_REFRESH_TTL="30d"

# CORS — comma-separated origins. Vacío en producción lanza al boot.
# Dev: vacío → CORS efectivamente bloqueado (mejor explícito).
CORS_ORIGINS=http://localhost:7100

# Mailer SMTP — sin SMTP_USER/SMTP_PASS el mailer corre en modo no-op (loguea en consola).
# Producción NightPass usa Gmail SMTP con contraseña de aplicación.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NightPass <no-reply@nightpass.mx>"
ADMIN_NOTIFICATION_EMAIL="admin@nightpass.local"

# URL pública del panel admin (para construir links en emails).
ADMIN_WEB_URL="http://localhost:7100"

# Storage — driver `r2` en prod, `local` en dev.
STORAGE_DRIVER=local
LOCAL_UPLOADS_PATH=./uploads
LOCAL_UPLOADS_URL=http://localhost:7101/uploads

# Cloudflare R2 (requerido si STORAGE_DRIVER=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nightpass-media
R2_PUBLIC_URL=https://pub-XXXXX.r2.dev

# Stripe Connect (Fase 3) — sin estas vars el módulo stripe corre en modo no-op.
# Si STRIPE_SECRET_KEY está set, STRIPE_WEBHOOK_SECRET y PASS_HMAC_SECRET son obligatorios.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLATFORM_FEE_PCT=8
STRIPE_CONNECT_COUNTRY=MX
STRIPE_CONNECT_DEFAULT_CURRENCY=mxn

# Pass HMAC signing — secreto para firmar QR codes de pases (Fase 3). Min 32 chars.
PASS_HMAC_SECRET=
