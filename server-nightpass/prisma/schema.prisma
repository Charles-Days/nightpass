generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  VENUE_OWNER
  VENUE_STAFF
  PROMOTER
  PROMOTER_STAFF
  RP
  CUSTOMER
}

enum VenueStatus {
  ACTIVE
  SUSPENDED
}

enum PromoterStatus {
  ACTIVE
  SUSPENDED
}

enum PromoterMemberRole {
  OWNER
  STAFF
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELED
}

enum OrderStatus {
  PENDING
  COMPLETED
  REFUNDED
  FAILED
}

enum PaymentMethod {
  STRIPE
  CASH
  COMP
}

enum PassClaimStatus {
  PENDING
  CLAIMED
  EXPIRED
  CANCELLED
}

// Forma en que el RP comparte el vale.
// QR   = presencial: lo muestra y el cliente lo escanea ahí mismo → TTL corto
//        (10 min); si nadie lo reclama, expira y libera el aforo.
// LINK = a distancia (WhatsApp, etc.): el cliente lo abre cuando puede → NO
//        expira a los 10 min; vive hasta una semana después del evento.
enum PassClaimChannel {
  QR
  LINK
}

// Cómo se aplica la comisión NightPass al PRECIO en efectivo de un tier.
// SUBTRACT = el cliente paga el precio base (efectivo no paga Stripe) y la
// organización absorbe la comisión vía el wallet prepagado (comportamiento
// actual). ADD = el cliente paga base + comisión (la org la recupera del
// cliente). En ambos casos el cobro real de la comisión sigue ocurriendo en el
// wallet; este modo solo cambia el monto que el cliente entrega en efectivo.
enum CashFeeMode {
  ADD
  SUBTRACT
}

// Estado de una solicitud de pago en EFECTIVO iniciada por el cliente desde la
// app. PENDING = esperando que un RP asignado al evento cobre y confirme.
// CONFIRMED = el RP cobró → se emitió el/los Pass directo a la cuenta del
// cliente. CANCELLED = cancelada por el cliente o el RP. EXPIRED = venció sin
// confirmarse (pasó el inicio del evento).
enum PhysicalPaymentRequestStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum TransferStatus {
  PENDING
  CLAIMED
  CANCELLED
  EXPIRED
}

enum LoyaltyEventType {
  EVENT_CHECKIN
  VENUE_CHECKIN
  FIRST_VENUE_BONUS
  STREAK_DAILY_BONUS
  STREAK_MILESTONE
  BRING_FRIEND_BONUS
  REFERRAL_VISIT
  REFERRAL_SIGNUP
  REDEEM
  ADMIN_ADJUST
  PHYSICAL_BONUS
}

enum OAuthProvider {
  GOOGLE
}

enum StoryMediaType {
  IMAGE
  VIDEO
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  email        String   @unique
  passwordHash String?
  name         String?
  // WhatsApp/teléfono de contacto. Se pide la primera vez que el cliente
  // solicita pago en efectivo y se reutiliza en las siguientes.
  phone        String?
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  mustChangePassword  Boolean   @default(false)
  locationOnboardedAt DateTime?
  // Ubicación declarada para el ranking de loyalty (no es el GPS de LocationPing).
  state               String?
  city                String?
  // Consentimiento para aparecer en el ranking público. null = aún no decide
  // (se le pregunta una vez), true = aparece, false = optó por no salir.
  rankingOptIn        Boolean?

  // Referidos cliente→cliente: código propio para invitar (se genera la 1ª vez
  // que abre "Invita y gana") y de quién vino este usuario (atribución).
  referralCode String? @unique
  referredById String? @db.Uuid

  oauthAccounts OAuthAccount[]

  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emailChangeTokens       EmailChangeToken[]
  ownedVenues             VenueOwner[]
  applications            VenueApplication[]       @relation("ApplicantApps")
  reviewedApps            VenueApplication[]       @relation("ReviewerApps")
  staffMemberships        VenueStaff[]             @relation("staffMemberships")
  sentInvites             VenueStaff[]             @relation("sentInvites")
  promoterMemberships     PromoterMember[]
  promoterApplications    PromoterApplication[]    @relation("PromoterApplicantApps")
  reviewedPromoterApps    PromoterApplication[]    @relation("PromoterReviewerApps")
  orders                  Order[]
  passes                  Pass[]
  passesScanned           Pass[]                   @relation("PassesScanned")
  locationPings           LocationPing[]
  loyaltyEvents           LoyaltyEvent[]
  streak                  UserStreak?
  loyaltyTotal            UserLoyaltyTotal?
  referredBy              User?                    @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals               User[]                   @relation("UserReferrals")
  rewardRedemptions       RewardRedemption[]
  createdStories          Story[]                  @relation("StoryAuthor")
  forumPosts              EventForumPost[]
  pushSubscriptions       PushSubscription[]
  notifications           Notification[]
  rpProfile               RpProfile?
  claimedPasses           PassClaim[]              @relation("UserClaimedPasses")
  adminGeneratedClaims    PassClaim[]              @relation("AdminGeneratedClaims")
  transfersSent           PassTransfer[]           @relation("TransfersSent")
  transfersReceived       PassTransfer[]           @relation("TransfersReceived")
  physicalPaymentRequests PhysicalPaymentRequest[] @relation("UserPhysicalRequests")

  @@map("users")
}

model PushSubscription {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// Notificación persistida en el panel (campana del topbar). A diferencia del
// web-push (transitorio, a nivel OS), estas se guardan y tienen estado leído.
// Una fila por destinatario: la misma solicitud genera N notificaciones (RP
// asignado + organizador + dueño del local + admins). `data` lleva el detalle
// completo del cliente para renderizar inline sin otra consulta.
enum NotificationType {
  PHYSICAL_REQUEST_CREATED
  PHYSICAL_REQUEST_CONFIRMED
  PHYSICAL_REQUEST_CANCELLED
  PHYSICAL_REQUEST_EXPIRED
}

model Notification {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @db.Uuid // destinatario
  type      NotificationType
  title     String
  body      String
  url       String? // ruta del panel a la que lleva al hacer click (según rol)
  data      Json? // payload extra: { requestId, eventId, customer, ... }
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?
  ipAddress String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  ipAddress String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailChangeToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  newEmail  String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_change_tokens")
}

model Venue {
  id        String      @id @default(uuid(7)) @db.Uuid
  slug      String      @unique
  name      String
  city      String
  address   String?
  phone     String?
  status    VenueStatus @default(ACTIVE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  rewards   Reward[]

  description    String?
  capacity       Int?
  priceFromCents Int?
  currency       String?
  latitude       Float?
  longitude      Float?
  googleMapsUrl  String?
  coverImageUrl  String?
  categories     String[]
  openHours      Json?

  // Additional operational fields
  menuUrl     String?
  musicTypes  String[]
  socialLinks Json?
  dressCode   String?
  minAge      Int?

  // Geofence radius for QR redeem (meters; 0 disables the check).
  geofenceRadiusM Int @default(100)

  // Featured: admin pin to top of public listings.
  isFeatured     Boolean   @default(false)
  featuredAt     DateTime?
  featuredReason String?

  // Platform fee % NightPass keeps per ticket (0-100). Admin-set.
  // null = usa la comisión global del servidor; un número (incl. 0) es explícito.
  platformFeePct Float?

  // Si true (default), las ventas en EFECTIVO no cobran comisión a NightPass y
  // no requieren saldo (wallet). Si false, cada pase de efectivo debita la
  // comisión (mismo % que online) del CashWallet del organizador al confirmar.
  cashCommissionExempt Boolean @default(true)

  // Loyalty: static QR for venue check-in (free, +10 NPP, 1/day/user).
  // Null = check-in disabled until owner rotates a QR.
  checkinQrSecret   String?
  checkinQrIssuedAt DateTime?

  owners        VenueOwner[]
  staff         VenueStaff[]
  photos        Photo[]
  events        Event[]
  stripeAccount StripeAccount?
  cashWallet    CashWallet?
  loyaltyEvents LoyaltyEvent[]
  stories       Story[]

  @@index([city])
  @@index([status, createdAt])
  @@map("venues")
}

model VenueOwner {
  userId    String   @db.Uuid
  venueId   String   @db.Uuid
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@id([userId, venueId])
  @@index([venueId])
  @@map("venue_owners")
}

model VenueApplication {
  id              String            @id @default(uuid(7)) @db.Uuid
  applicantUserId String            @db.Uuid
  venueName       String
  city            String
  address         String?
  phone           String?
  message         String?
  status          ApplicationStatus @default(PENDING)
  rejectionReason String?
  reviewedById    String?           @db.Uuid
  reviewedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  applicant User  @relation("ApplicantApps", fields: [applicantUserId], references: [id], onDelete: Cascade)
  reviewer  User? @relation("ReviewerApps", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([applicantUserId, status])
  @@index([status, createdAt])
  @@map("venue_applications")
}

enum VenueStaffRole {
  MANAGER
  SCANNER
}

enum VenueStaffStatus {
  PENDING
  ACTIVE
  REVOKED
}

model VenueStaff {
  id          String           @id @default(uuid(7)) @db.Uuid
  venueId     String           @db.Uuid
  userId      String           @db.Uuid
  invitedById String           @db.Uuid
  staffRole   VenueStaffRole   @default(SCANNER)
  status      VenueStaffStatus @default(PENDING)
  invitedAt   DateTime         @default(now())
  joinedAt    DateTime?

  venue     Venue @relation(fields: [venueId], references: [id])
  user      User  @relation("staffMemberships", fields: [userId], references: [id])
  invitedBy User  @relation("sentInvites", fields: [invitedById], references: [id])

  @@unique([venueId, userId])
  @@index([userId])
  @@index([venueId, status])
  @@map("venue_staff")
}

model Promoter {
  id        String         @id @default(uuid(7)) @db.Uuid
  slug      String         @unique
  name      String
  city      String
  phone     String?
  instagram String?
  website   String?
  bio       String?
  logoUrl   String?
  status    PromoterStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  rewards   Reward[]

  // Platform fee % NightPass keeps per ticket (0-100). Admin-set.
  // null = usa la comisión global del servidor; un número (incl. 0) es explícito.
  platformFeePct Float?

  // Ver Venue.cashCommissionExempt — mismo comportamiento para organizadores.
  cashCommissionExempt Boolean @default(true)

  members       PromoterMember[]
  events        Event[]
  applications  PromoterApplication[] @relation("ApprovedPromoter")
  stripeAccount StripeAccount?
  cashWallet    CashWallet?
  rpProfiles    RpProfile[]

  @@index([city])
  @@index([status, createdAt])
  @@map("promoters")
}

model PromoterMember {
  userId     String             @db.Uuid
  promoterId String             @db.Uuid
  role       PromoterMemberRole @default(OWNER)
  createdAt  DateTime           @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  promoter Promoter @relation(fields: [promoterId], references: [id], onDelete: Cascade)

  @@id([userId, promoterId])
  @@index([promoterId])
  @@map("promoter_members")
}

model PromoterApplication {
  id                 String            @id @default(uuid(7)) @db.Uuid
  applicantUserId    String            @db.Uuid
  promoterName       String
  city               String
  phone              String?
  instagram          String?
  website            String?
  experience         String
  eventTypes         String[]
  message            String?
  status             ApplicationStatus @default(PENDING)
  rejectionReason    String?
  reviewedById       String?           @db.Uuid
  reviewedAt         DateTime?
  approvedPromoterId String?           @db.Uuid
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  applicant        User      @relation("PromoterApplicantApps", fields: [applicantUserId], references: [id], onDelete: Cascade)
  reviewer         User?     @relation("PromoterReviewerApps", fields: [reviewedById], references: [id], onDelete: SetNull)
  approvedPromoter Promoter? @relation("ApprovedPromoter", fields: [approvedPromoterId], references: [id], onDelete: SetNull)

  @@index([applicantUserId, status])
  @@index([status, createdAt])
  @@map("promoter_applications")
}

model Photo {
  id        String   @id @default(uuid(7)) @db.Uuid
  venueId   String?  @db.Uuid
  eventId   String?  @db.Uuid
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  venue Venue? @relation(fields: [venueId], references: [id])
  event Event? @relation(fields: [eventId], references: [id])

  @@index([venueId])
  @@index([eventId])
  @@map("photos")
}

model Event {
  id               String      @id @default(uuid(7)) @db.Uuid
  venueId          String?     @db.Uuid
  promoterId       String?     @db.Uuid
  slug             String
  title            String
  description      String?
  startsAt         DateTime
  endsAt           DateTime
  coverImageUrl    String?
  flyerImageUrl    String?
  status           EventStatus @default(DRAFT)
  capacity         Int?
  // Boost de aforo SOLO visual (FOMO): se suma al % "lleno" que se muestra al
  // público. NO afecta el aforo real ni la lógica de cupo/sobreventa — es solo
  // marketing. 0 = sin boost. Lo ajusta el ADMIN.
  aforoBoostPct    Int         @default(0)
  // Habilita el flujo de PAGO EN EFECTIVO (boleto digital, pago físico vía RP).
  // Si es false, la app no ofrece la opción y el backend rechaza solicitudes.
  allowCashPayment Boolean     @default(false)
  // Habilita el PAGO EN LÍNEA (Stripe). Si es false, el evento es solo-efectivo:
  // la app oculta la tarjeta y el backend rechaza crear órdenes online. Junto con
  // allowCashPayment define el modo de venta (solo efectivo / solo línea / ambas).
  // Al menos uno debe estar activo (se valida en el service).
  allowOnlinePayment Boolean   @default(true)
  isFeatured       Boolean     @default(false)
  featuredAt       DateTime?
  featuredReason   String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  externalVenueName    String?
  externalVenueAddress String?
  externalVenueCity    String?
  externalVenueLat     Float?
  externalVenueLng     Float?

  // Links de grupos de WhatsApp del evento. Array de { label, url }. El cliente
  // los ve en la info del evento. Lo gestiona el organizador/dueño.
  whatsappGroups Json?

  venue             Venue?                   @relation(fields: [venueId], references: [id])
  promoter          Promoter?                @relation(fields: [promoterId], references: [id])
  tiers             EventTier[]
  photos            Photo[]
  orders            Order[]
  passes            Pass[]
  loyaltyEvents     LoyaltyEvent[]
  stories           Story[]
  rpCommissionRules RpCommissionRule[]
  forumPosts        EventForumPost[]
  passClaims        PassClaim[]
  cashRps           EventRp[]
  physicalRequests  PhysicalPaymentRequest[]
  rewards           Reward[]                 @relation("EventRewards")

  @@unique([venueId, slug])
  @@unique([promoterId, slug])
  @@index([venueId, status])
  @@index([promoterId, status])
  @@index([startsAt])
  @@index([externalVenueCity])
  @@map("events")
}

model EventForumPost {
  id        String    @id @default(uuid(7)) @db.Uuid
  eventId   String    @db.Uuid
  userId    String    @db.Uuid
  body      String    @db.VarChar(280)
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
  @@index([userId])
  @@map("event_forum_posts")
}

model EventTier {
  id                 String       @id @default(uuid(7)) @db.Uuid
  eventId            String       @db.Uuid
  name               String
  priceCents         Int
  currency           String       @default("MXN")
  capacity           Int?
  position           Int          @default(0)
  // Config de efectivo por-tier (override de los valores del owner). Todos
  // nullable: null = heredar.
  cashFeeMode        CashFeeMode? // null => SUBTRACT (comportamiento actual)
  cashFeePctOverride Float? // null => usar platformFeePct del owner (o global)
  cashExemptOverride Boolean? // null => usar cashCommissionExempt del owner
  cashPriceCents     Int? // precio en efectivo propio; null => derivar del online (bruto - Stripe)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  event            Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orders           Order[]
  prices           EventTierPrice[]
  passClaims       PassClaim[]
  physicalRequests PhysicalPaymentRequest[]
  rewards          Reward[]                 @relation("EventTierRewards")

  @@index([eventId])
  @@map("event_tiers")
}

// Subidas de precio programadas (early-bird → sube al acercarse el evento).
// El precio activo = la fase con mayor `daysBeforeEvent` ya alcanzada respecto a
// `event.startsAt`; antes de cualquier fase aplica `EventTier.priceCents` (base).
model EventTierPrice {
  id              String   @id @default(uuid(7)) @db.Uuid
  tierId          String   @db.Uuid
  priceCents      Int
  // Se activa este número de días naturales antes de `event.startsAt`.
  daysBeforeEvent Int
  position        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tier EventTier @relation(fields: [tierId], references: [id], onDelete: Cascade)

  @@index([tierId])
  @@map("event_tier_prices")
}

model StripeAccount {
  id               String   @id @default(uuid(7)) @db.Uuid
  venueId          String?  @unique @db.Uuid
  promoterId       String?  @unique @db.Uuid
  stripeAccountId  String   @unique
  chargesEnabled   Boolean  @default(false)
  detailsSubmitted Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  venue    Venue?    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  promoter Promoter? @relation(fields: [promoterId], references: [id], onDelete: Cascade)

  @@map("stripe_accounts")
}

model Order {
  id                     String        @id @default(uuid(7)) @db.Uuid
  userId                 String        @db.Uuid
  eventId                String        @db.Uuid
  tierId                 String        @db.Uuid
  status                 OrderStatus   @default(PENDING)
  paymentMethod          PaymentMethod @default(STRIPE)
  quantity               Int           @default(1)
  totalCents             Int
  applicationFeeCents    Int
  currency               String        @default("MXN")
  stripePaymentIntentId  String?       @unique
  stripeEventLastApplied String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  user            User                    @relation(fields: [userId], references: [id])
  event           Event                   @relation(fields: [eventId], references: [id])
  tier            EventTier               @relation(fields: [tierId], references: [id])
  passes          Pass[]
  passClaim       PassClaim?
  physicalRequest PhysicalPaymentRequest?
  referredByRpId  String?                 @db.Uuid
  referredByRp    RpProfile?              @relation("RpReferredOrders", fields: [referredByRpId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([eventId, status])
  @@index([eventId, paymentMethod, createdAt])
  @@map("orders")
}

model Pass {
  id                String    @id @default(uuid(7)) @db.Uuid
  orderId           String    @db.Uuid
  userId            String    @db.Uuid
  eventId           String    @db.Uuid
  qrCode            String    @unique
  usedAt            DateTime?
  usedByStaffId     String?   @db.Uuid
  redeemedDistanceM Int?
  redeemedAccuracyM Int?
  createdAt         DateTime  @default(now())

  order         Order          @relation(fields: [orderId], references: [id])
  user          User           @relation(fields: [userId], references: [id])
  event         Event          @relation(fields: [eventId], references: [id])
  usedByStaff   User?          @relation("PassesScanned", fields: [usedByStaffId], references: [id])
  loyaltyEvents LoyaltyEvent[]
  transfers     PassTransfer[]

  @@index([userId])
  @@index([eventId, usedAt])
  @@index([eventId, createdAt])
  @@map("passes")
}

// Transferencia de un pase YA pagado a otra persona. A diferencia de PassClaim
// (que emite un pase nuevo), esto solo reasigna el dueño del Pass existente: al
// aceptarla se cambia `Pass.userId` y se RE-FIRMA el QR (el HMAC incluye userId),
// por lo que el QR viejo del remitente queda inválido automáticamente. No crea
// Order nuevo ni recuenta aforo — el pase ya existía y ya estaba pagado.
//
// Modo link-abierto: cualquiera con el `token` puede aceptarla (bearer, como un
// boleto físico). Single-use, cancelable por el remitente, expira en el inicio
// del evento (o +7d, lo que ocurra antes). Mientras está PENDING el pase queda
// bloqueado para escaneo (ver PassesService.scan) para evitar doble entrada.
model PassTransfer {
  id         String         @id @default(uuid(7)) @db.Uuid
  passId     String         @db.Uuid
  token      String         @unique
  fromUserId String         @db.Uuid
  toUserId   String?        @db.Uuid
  status     TransferStatus @default(PENDING)
  expiresAt  DateTime
  claimedAt  DateTime?
  createdAt  DateTime       @default(now())

  pass     Pass  @relation(fields: [passId], references: [id], onDelete: Cascade)
  fromUser User  @relation("TransfersSent", fields: [fromUserId], references: [id])
  toUser   User? @relation("TransfersReceived", fields: [toUserId], references: [id])

  @@index([passId, status])
  @@index([fromUserId, status])
  @@map("pass_transfers")
}

enum LocationPingSource {
  APP_OPEN
  PASS_VIEW
  REDEEM
  SCAN_REDEEM
  VENUE_CHECKIN
}

model LocationPing {
  id        String             @id @default(uuid(7)) @db.Uuid
  userId    String             @db.Uuid
  latitude  Float
  longitude Float
  accuracyM Float?
  source    LocationPingSource @default(APP_OPEN)
  createdAt DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt])
  @@index([createdAt, latitude, longitude])
  @@map("location_pings")
}

// ─── Loyalty ──────────────────────────────────────────────────────────────

/// Append-only ledger of point-awarding events. Idempotent via idempotencyKey.
model LoyaltyEvent {
  id             String           @id @default(uuid(7)) @db.Uuid
  userId         String           @db.Uuid
  type           LoyaltyEventType
  /// Signed integer. ADMIN_ADJUST may be negative.
  points         Int
  /// Multiplier applied at the time of the award (weekend, birthday, etc.).
  /// Effective points = round(base * multiplier).
  multiplier     Float            @default(1)
  venueId        String?          @db.Uuid
  eventId        String?          @db.Uuid
  passId         String?          @db.Uuid
  /// e.g. "scan:<passId>" or "checkin:<venueId>:<userId>:<YYYY-MM-DD>"
  idempotencyKey String           @unique
  occurredAt     DateTime         @default(now())
  metadata       Json?

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue Venue? @relation(fields: [venueId], references: [id], onDelete: SetNull)
  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  pass  Pass?  @relation(fields: [passId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt(sort: Desc)])
  @@index([venueId, occurredAt(sort: Desc)])
  @@map("loyalty_events")
}

/// Per-user streak tracker. Updated transactionally with LoyaltyEvent.
model UserStreak {
  userId             String    @id @db.Uuid
  currentDays        Int       @default(0)
  longestDays        Int       @default(0)
  /// UTC date (truncated to day) of the last awarding check-in.
  lastCheckinDate    DateTime?
  /// Freezes remaining this calendar month.
  freezesRemaining   Int       @default(2)
  freezesRefreshedAt DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_streaks")
}

/// Cached aggregates so we don't sum the ledger on every request.
/// Recomputed inside applyReward() transaction.
model UserLoyaltyTotal {
  userId      String   @id @db.Uuid
  /// All-time effective points (spendable balance).
  totalPoints Int      @default(0)
  /// Effective points within last 365 days. Drives the city ranking.
  yearPoints  Int      @default(0)
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_loyalty_totals")
}

model OAuthAccount {
  id          String        @id @default(uuid(7)) @db.Uuid
  userId      String        @db.Uuid
  provider    OAuthProvider
  providerSub String
  email       String?
  createdAt   DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSub])
  @@index([userId])
  @@map("oauth_accounts")
}

model Story {
  id          String         @id @default(uuid(7)) @db.Uuid
  venueId     String?        @db.Uuid
  eventId     String?        @db.Uuid
  createdById String         @db.Uuid
  mediaUrl    String
  mediaType   StoryMediaType
  durationMs  Int?
  caption     String?        @db.VarChar(280)
  createdAt   DateTime       @default(now())
  expiresAt   DateTime
  deletedAt   DateTime?

  venue     Venue? @relation(fields: [venueId], references: [id], onDelete: Cascade)
  event     Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy User   @relation("StoryAuthor", fields: [createdById], references: [id])

  @@index([venueId, expiresAt])
  @@index([eventId, expiresAt])
  @@index([expiresAt])
  @@map("stories")
}

enum RpCommissionType {
  PER_N_TICKETS
  PERCENTAGE
}

model RpProfile {
  id          String   @id @default(uuid(7)) @db.Uuid
  userId      String   @unique @db.Uuid
  promoterId  String?  @db.Uuid
  rpCode      String   @unique
  displayName String
  isActive    Boolean  @default(true)
  // Zona del RP — para enrutar solicitudes de pago en efectivo a quien cubre la
  // ciudad/estado del cliente. Reparto equitativo entre los que coinciden.
  state       String?
  city        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user                      User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  promoter                  Promoter?                @relation(fields: [promoterId], references: [id], onDelete: SetNull)
  orders                    Order[]                  @relation("RpReferredOrders")
  commissionRules           RpCommissionRule[]
  issuedClaims              PassClaim[]              @relation("RpIssuedClaims")
  eventAssignments          EventRp[]
  confirmedPhysicalRequests PhysicalPaymentRequest[] @relation("RpConfirmedRequests")
  assignedPhysicalRequests  PhysicalPaymentRequest[] @relation("RpAssignedRequests")
  pickupPoints              RpPickupPoint[]

  @@index([rpCode])
  @@index([promoterId])
  @@map("rp_profiles")
}

// Pase emitido por un RP para una venta física (efectivo). Es un "vale" con un
// token que viaja dentro de un QR. El cliente lo escanea en su app → se crea la
// Order (CASH, COMPLETED) + el Pass real a su nombre y el claim queda CLAIMED.
model PassClaim {
  id                 String          @id @default(uuid(7)) @db.Uuid
  token              String          @unique
  eventId            String          @db.Uuid
  tierId             String          @db.Uuid
  issuedByRpId       String?         @db.Uuid
  generatedByAdminId String?         @db.Uuid
  amountCents        Int
  currency           String          @default("MXN")
  status             PassClaimStatus @default(PENDING)
  // Cómo se compartió el vale. Define su vigencia (ver enum PassClaimChannel) y
  // permite clasificar en los paneles cuántas ventas vinieron por link vs QR.
  channel            PassClaimChannel @default(QR)
  claimedByUserId    String?         @db.Uuid
  claimedAt          DateTime?
  orderId            String?         @unique @db.Uuid
  expiresAt          DateTime
  createdAt          DateTime        @default(now())

  event            Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tier             EventTier  @relation(fields: [tierId], references: [id], onDelete: Cascade)
  issuedByRp       RpProfile? @relation("RpIssuedClaims", fields: [issuedByRpId], references: [id], onDelete: SetNull)
  claimedBy        User?      @relation("UserClaimedPasses", fields: [claimedByUserId], references: [id], onDelete: SetNull)
  generatedByAdmin User?      @relation("AdminGeneratedClaims", fields: [generatedByAdminId], references: [id], onDelete: SetNull)
  order            Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([issuedByRpId, status])
  @@index([eventId, status])
  @@map("pass_claims")
}

// Asignación explícita de un RP a un evento PARA COBRO EN EFECTIVO. Es la lista
// de RPs que reciben el correo cuando un cliente pide pagar en físico ese
// evento, y los únicos autorizados a confirmar esas solicitudes. Independiente
// de RpCommissionRule (comisión) y de la pertenencia a un promoter.
model EventRp {
  id          String   @id @default(uuid(7)) @db.Uuid
  eventId     String   @db.Uuid
  rpProfileId String   @db.Uuid
  createdAt   DateTime @default(now())

  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rpProfile RpProfile @relation(fields: [rpProfileId], references: [id], onDelete: Cascade)

  @@unique([eventId, rpProfileId])
  @@index([rpProfileId])
  @@map("event_rps")
}

// Solicitud de PAGO EN EFECTIVO: el boleto es digital pero el cobro es físico.
// El cliente la crea desde la app (elige tier + cantidad); se notifica por
// correo a los RPs asignados al evento (EventRp). Cuando un RP cobra en persona,
// confirma la solicitud en el panel → se emiten los Pass directo a la cuenta del
// cliente (Order CASH COMPLETED + issuePasses), atribuidos al RP que confirmó.
// El monto se congela al precio vigente al momento de la solicitud.
model PhysicalPaymentRequest {
  id              String                       @id @default(uuid(7)) @db.Uuid
  userId          String                       @db.Uuid
  eventId         String                       @db.Uuid
  tierId          String                       @db.Uuid
  quantity        Int                          @default(1)
  // amountCents = lo que paga el cliente en efectivo (bruto − Stripe [− NP si
  // exento]). grossCents = bruto original (online), base para la comisión NP.
  amountCents     Int
  grossCents      Int?
  currency        String                       @default("MXN")
  status          PhysicalPaymentRequestStatus @default(PENDING)
  contactPhone    String?
  note            String?
  // RP al que se ENRUTÓ la solicitud (reparto equitativo por ciudad/estado).
  // Solo este RP recibe el correo y puede confirmarla.
  assignedRpId    String?                      @db.Uuid
  confirmedByRpId String?                      @db.Uuid
  confirmedAt     DateTime?
  orderId         String?                      @unique @db.Uuid
  // Punto de cobro elegido por el cliente + slot (día/hora) que eligió. Null en
  // solicitudes viejas (pre-puntos) o cuando se ruteó sin punto explícito.
  pickupPointId   String?                      @db.Uuid
  pickupAt        DateTime?
  expiresAt       DateTime
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  user          User           @relation("UserPhysicalRequests", fields: [userId], references: [id], onDelete: Cascade)
  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tier          EventTier      @relation(fields: [tierId], references: [id], onDelete: Cascade)
  assignedRp    RpProfile?     @relation("RpAssignedRequests", fields: [assignedRpId], references: [id], onDelete: SetNull)
  confirmedByRp RpProfile?     @relation("RpConfirmedRequests", fields: [confirmedByRpId], references: [id], onDelete: SetNull)
  order         Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  pickupPoint   RpPickupPoint? @relation(fields: [pickupPointId], references: [id], onDelete: SetNull)

  @@index([eventId, status])
  @@index([userId, status])
  @@index([confirmedByRpId, status])
  @@index([assignedRpId, status])
  @@index([pickupPointId, status])
  @@map("physical_payment_requests")
}

// Punto físico donde un RP cobra efectivo y entrega boletos: lugar + coordenadas
// + horarios. El cliente, al pagar en efectivo, elige el que le queda más cerca
// (orden por Haversine) y reserva en su cola. Coords vienen de un link de Google
// Maps (parseado) o de un pin en mapa OSM. Ver docs/RP_PUNTOS_COBRO.md.
model RpPickupPoint {
  id          String   @id @default(uuid(7)) @db.Uuid
  rpProfileId String   @db.Uuid
  label       String
  // Referencia en texto de dónde estará exactamente el RP (el pin es aproximado):
  // "Enfrente de la plaza, junto al Oxxo azul". Lo ve el cliente.
  reference   String?
  latitude    Float
  longitude   Float
  // Link de Google Maps para el botón "cómo llegar" del cliente (opcional).
  mapsUrl     String?
  // Ventanas horarias: array JSON de { dow, start, end }. dow: 0-6 (Dom-Sáb) o
  // null = cualquier día. start/end: "HH:mm" 24h.
  windows     Json     @default("[]")
  // Punto especial "puerta del evento": siempre se muestra al final como red de
  // seguridad (no se pierde la venta del que está lejos).
  isVenueDoor Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rpProfile RpProfile                @relation(fields: [rpProfileId], references: [id], onDelete: Cascade)
  requests  PhysicalPaymentRequest[]

  @@index([rpProfileId, isActive])
  @@map("rp_pickup_points")
}

// Saldo PREPAGADO del organizador (venue o promoter) para cubrir la comisión de
// NightPass en VENTAS EN EFECTIVO. Como el dinero del efectivo nunca pasa por
// Stripe, NightPass no puede retener su comisión ahí: el organizador la paga por
// adelantado recargando este wallet (PaymentIntent directo a la plataforma, sin
// Connect). Al confirmar un pase de efectivo, se debita `comisión% × precio` del
// saldo. Sin saldo suficiente, el RP no puede confirmar. Cobramos ANTES de
// emitir → cero riesgo de impago. Solo aplica si cashCommissionExempt = false.
model CashWallet {
  id           String   @id @default(uuid(7)) @db.Uuid
  venueId      String?  @unique @db.Uuid
  promoterId   String?  @unique @db.Uuid
  balanceCents Int      @default(0)
  currency     String   @default("MXN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  venue        Venue?                  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  promoter     Promoter?               @relation(fields: [promoterId], references: [id], onDelete: Cascade)
  transactions CashWalletTransaction[]

  @@map("cash_wallets")
}

enum CashWalletTxType {
  TOPUP // recarga vía Stripe (crédito)
  CASH_FEE_DEBIT // comisión cobrada al confirmar un pase de efectivo (débito)
  ADJUSTMENT // ajuste manual por admin (+/-)
  REVERSAL // reverso de un débito (p.ej. solicitud cancelada)
}

// Movimiento del CashWallet. `amountCents` es CON SIGNO: positivo = crédito,
// negativo = débito. `balanceAfterCents` guarda el saldo resultante para
// auditoría. Idempotencia de recargas vía `stripePaymentIntentId` único.
model CashWalletTransaction {
  id                    String           @id @default(uuid(7)) @db.Uuid
  walletId              String           @db.Uuid
  type                  CashWalletTxType
  amountCents           Int
  balanceAfterCents     Int
  currency              String           @default("MXN")
  note                  String?
  physicalRequestId     String?          @db.Uuid
  orderId               String?          @db.Uuid
  stripePaymentIntentId String?          @unique
  createdAt             DateTime         @default(now())

  wallet CashWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@map("cash_wallet_transactions")
}

// Key-value de configuración global de la app. Hoy solo guarda el flag de
// mantenimiento (`key = "maintenance"`, `value = { enabled, message }`), pero
// sirve para futuros toggles sin migración nueva.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

model RpCommissionRule {
  id          String           @id @default(uuid(7)) @db.Uuid
  rpProfileId String           @db.Uuid
  eventId     String?          @db.Uuid
  type        RpCommissionType @default(PER_N_TICKETS)
  nTickets    Int?
  rewardCents Int?
  currency    String           @default("MXN")
  percentage  Float?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  rpProfile RpProfile @relation(fields: [rpProfileId], references: [id], onDelete: Cascade)
  event     Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([rpProfileId, eventId])
  @@index([rpProfileId])
  @@map("rp_commission_rules")
}

// Eventos de analítica para reconstruir el recorrido del visitante (embudo):
// qué páginas vio, en qué orden y dónde terminó. Distinto del contador HLL de
// `MetricsService` (que solo cuenta únicos). `visitorId` = cookie np_vid o hash
// IP+UA; `userId` se llena si ya tenía sesión. `name` es el paso del embudo
// (page_view, view_event, open_checkout, view_signup, signup_complete).
model AnalyticsEvent {
  id        String   @id @default(uuid(7)) @db.Uuid
  visitorId String
  userId    String?  @db.Uuid
  name      String
  path      String
  eventId   String?  @db.Uuid
  referrer  String?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([visitorId, createdAt])
  @@index([createdAt])
  @@map("analytics_events")
}

// ── Recompensas (canje de NPP) ───────────────────────────────────────────────
// Ver docs/RECOMPENSAS_CANJE.md para el modelo económico completo.

enum RewardKind {
  VENUE_PERK // lo valida el staff en barra/puerta (scanner), no toca Stripe
  TICKET_DISCOUNT // se aplica en el checkout online (Fase 2)
  BULK_PROMO // GRATIS: por comprar minQuantity boletos, el cliente elige 1 opción
  PHYSICAL_BONUS_NPP // NPP extra cuando un RP confirma un pago físico (por evento)
  PURCHASE_PERK // GRATIS e informativo: comprar 1+ boleto dentro de la ventana de fechas otorga un perk (texto + imagen) que se muestra en el boleto del cliente
}

enum RewardFunder {
  VENUE
  PROMOTER
  NIGHTPASS
}

enum RewardDiscountType {
  NONE // perk no monetario (trago, line-skip)
  PERCENT // % sobre la orden
  FIXED // monto fijo en centavos MXN
}

enum RedemptionStatus {
  PENDING
  USED
  EXPIRED
  REVERSED
}

model Reward {
  id               String             @id @default(uuid(7)) @db.Uuid
  // Dueño que la ofrece (exactamente uno de los dos).
  venueId          String?            @db.Uuid
  promoterId       String?            @db.Uuid
  kind             RewardKind
  funder           RewardFunder
  title            String
  description      String?
  costNpp          Int // NPP que cuesta canjearla
  discountType     RewardDiscountType @default(NONE)
  discountValue    Int                @default(0) // PERCENT: 1-100 · FIXED: centavos
  maxDiscountCents Int? // tope para PERCENT
  active           Boolean            @default(true)
  perUserLimit     Int? // canjes por usuario (null = sin límite)
  expiresInH       Int                @default(72) // vigencia del cupón tras canjear
  // Alcance por evento (BULK_PROMO / PHYSICAL_BONUS_NPP). null = no atado a evento.
  eventId          String?            @db.Uuid
  // BULK_PROMO: tier que dispara la promo (null = cualquiera del evento).
  tierId           String?            @db.Uuid
  // BULK_PROMO: boletos a comprar para desbloquear (>=2).
  minQuantity      Int?
  // PHYSICAL_BONUS_NPP: NPP a otorgar al confirmar el pago físico (>=1).
  bonusNpp         Int?
  // Banner de la promo (imagen). null = sin banner.
  imageUrl         String?
  // Ventana de validez de la promo. null = sin inicio / sin fin.
  startsAt         DateTime?
  endsAt           DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  venue       Venue?             @relation(fields: [venueId], references: [id], onDelete: Cascade)
  promoter    Promoter?          @relation(fields: [promoterId], references: [id], onDelete: Cascade)
  event       Event?             @relation("EventRewards", fields: [eventId], references: [id], onDelete: Cascade)
  tier        EventTier?         @relation("EventTierRewards", fields: [tierId], references: [id], onDelete: SetNull)
  redemptions RewardRedemption[]
  options     RewardOption[]

  @@index([venueId, active])
  @@index([promoterId, active])
  @@index([eventId])
  @@map("rewards")
}

model RewardOption {
  id          String   @id @default(uuid(7)) @db.Uuid
  rewardId    String   @db.Uuid
  label       String // ej. "Botella Jose Cuervo"
  description String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  reward      Reward             @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  redemptions RewardRedemption[]

  @@index([rewardId])
  @@map("reward_options")
}

model RewardRedemption {
  id           String           @id @default(uuid(7)) @db.Uuid
  rewardId     String           @db.Uuid
  userId       String           @db.Uuid
  costNpp      Int // snapshot del costo al canjear
  status       RedemptionStatus @default(PENDING)
  code         String           @unique // token corto del cupón/QR
  // Solo TICKET_DISCOUNT: a qué orden se aplicó y cuánto descontó de verdad.
  orderId      String?          @db.Uuid
  appliedCents Int?
  // Solo BULK_PROMO: opción elegida por el cliente (botella, etc.).
  selectedOptionId String?       @db.Uuid
  redeemedAt   DateTime         @default(now())
  usedAt       DateTime?
  expiresAt    DateTime

  reward         Reward        @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  selectedOption RewardOption? @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([rewardId])
  @@map("reward_redemptions")
}
